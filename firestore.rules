rules_version = '2';

// Reglas de seguridad de Cloud Firestore para Cine a Ciegas.
// Se pegan en Firebase Console -> Firestore Database -> Reglas -> Publicar.
// Resumen:
//  - Hay que haber iniciado sesión para todo.
//  - Un grupo se puede LEER por su código (para poder unirse), pero solo
//    sus miembros pueden modificarlo, y solo ellos ven sus géneros y películas.
//  - Alguien que no es miembro solo puede agregarse a sí mismo al grupo.
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function isMemberOf(groupId) {
      return signedIn()
        && request.auth.uid in get(/databases/$(database)/documents/groups/$(groupId)).data.memberIds;
    }

    match /groups/{groupId} {
      // Leer un grupo puntual por código (necesario para unirse).
      allow get: if signedIn();

      // Listar grupos: solo los grupos donde el usuario es miembro.
      allow list: if signedIn() && request.auth.uid in resource.data.memberIds;

      // Crear: el creador tiene que ser el único miembro inicial.
      allow create: if signedIn()
        && request.resource.data.ownerId == request.auth.uid
        && request.resource.data.memberIds == [request.auth.uid];

      // Modificar: los miembros pueden; un no-miembro solo puede sumarse a sí mismo.
      allow update: if signedIn() && (
        request.auth.uid in resource.data.memberIds
        || (
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['memberIds', 'members'])
          && request.resource.data.memberIds.size() == resource.data.memberIds.size() + 1
          && request.resource.data.memberIds.hasAll(resource.data.memberIds)
          && request.auth.uid in request.resource.data.memberIds
        )
      );

      // Borrar el grupo: solo quien lo creó.
      allow delete: if signedIn() && resource.data.ownerId == request.auth.uid;

      // Géneros de la ruleta: solo miembros.
      match /genres/{genreId} {
        allow read, write: if isMemberOf(groupId);
      }

      // Películas (cartelera e historial): solo miembros.
      match /movies/{movieId} {
        allow read, write: if isMemberOf(groupId);
      }
    }
  }
}
