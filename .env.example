# Copiá este archivo como ".env" y completá cada valor (sin comillas ni comas).
# Firebase: Configuración del proyecto -> Tus apps -> app web -> firebaseConfig
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=

# TMDB: themoviedb.org -> Configuración -> API -> "API Read Access Token" (el largo)
VITE_TMDB_TOKEN=
